NODE_ENV=development
PORT=5000
# Comma-separated frontend origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Supabase project settings → API. Keep the service-role key on the backend only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Must match the key used with pgp_sym_encrypt() for seller_credentials.encrypted_password.
SELLER_PASSWORD_ENCRYPTION_KEY=your-server-only-password-encryption-key
# Long random secret used to sign seller sessions. Do not expose it to the frontend.
SELLER_SESSION_SECRET=your-long-random-server-only-session-secret
# REDIS_URL=redis://localhost:6379
