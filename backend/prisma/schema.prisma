generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @unique @map("product_id")
  productName     String   @map("product_name")
  category        String
  subCategory     String?  @map("sub_category")
  material        String
  weight          String
  description     String?
  benefits        String?
  highlights      String?
  length          Decimal? @db.Decimal(10, 2)
  width           Decimal? @db.Decimal(10, 2)
  height          Decimal? @db.Decimal(10, 2)
  mrp             Decimal  @db.Decimal(12, 2)
  discountPrice   Decimal? @map("discount_price") @db.Decimal(12, 2)
  sellingPrice    Decimal  @map("selling_price") @db.Decimal(12, 2)
  coverImage      String?  @map("cover_image")
  additionalImages String[] @default([]) @map("additional_images")
  sku             String?  @unique
  stockQuantity   Int      @default(0) @map("stock_quantity")
  lowStockAlert   Int      @default(5) @map("low_stock_alert")
  stockStatus     String   @default("Out of Stock") @map("stock_status")
  howToUse        String?  @map("how_to_use")
  careInstruction String?  @map("care_instruction")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("seller_products")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @default("order")
  title     String
  message   String
  orderId   String?  @map("order_id") @db.Uuid
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}