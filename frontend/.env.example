# Leave this unset for local development: Vite proxies /api to the backend.
# For a deployed API, set its full URL (for example https://api.example.com/api).
VITE_API_URL=https://vedacraft-seller.onrender.com/api

# Customer portal base URL — the site where buyers and new sellers register.
# The "Become a seller" link in Login.jsx appends /seller-registration to this.
VITE_CUSTOMER_PORTAL_URL=https://test.vedacraftscommunity.in

# Override the orders API path (default: /orders).
# Change this only if the orders endpoint moves to a different route.
# VITE_ORDERS_ENDPOINT=/orders
